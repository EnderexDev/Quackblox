{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quackblox",
  "version": "0.2.4",
  "identifier": "dev.enderex.quackblox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quackblox",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#0a0a0c",
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDQTMxOTkyMEQzRjM2MUYKUldRZk5qOE5raG1qUE9kTGpTZVRmeEhxTTFRWWs5c2Y4cjVOcEJNZEw2aVFNUlVuZWVGQm05ZTMK",
      "endpoints": ["https://github.com/EnderexDev/Quackblox/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
